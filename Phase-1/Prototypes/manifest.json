{
  "manifest_version": 3,
  "name": "SkipSpeed",
  "version": "1.0.0",
  "description": "Presses Skip on YouTube ads as soon as it appears, and plays video on any site at up to 4.5x.",
  "minimum_chrome_version": "105",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SkipSpeed",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "speed-up": {
      "suggested_key": { "default": "Alt+Shift+Period" },
      "description": "Play video faster"
    },
    "speed-down": {
      "suggested_key": { "default": "Alt+Shift+Comma" },
      "description": "Play video slower"
    },
    "speed-reset": {
      "suggested_key": { "default": "Alt+Shift+0" },
      "description": "Return video to normal speed"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["speed.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://music.youtube.com/*",
        "*://www.youtube-nocookie.com/*"
      ],
      "js": ["skip.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
